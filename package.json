{
  "name": "bitcoin-paper-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n engine,next \"npm:engine\" \"next dev --hostname 127.0.0.1 --port 3000\"",
    "engine": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "next build",
    "start": "concurrently -k -n engine,next \"npm:engine\" \"next start --hostname 127.0.0.1 --port 3000\"",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
