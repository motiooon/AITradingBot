FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src ./src
COPY tsconfig.json ./
RUN mkdir -p /app/data && chown -R node:node /app/data
USER node
ENV API_HOST=0.0.0.0 API_PORT=3001 DATA_DIR=/app/data AUTO_RESUME=true
EXPOSE 3001
CMD ["npm", "run", "engine"]
